ENV=development
PORT=3000
API_VERSION=v1

MONGODB_URL=mongodb://localhost:27017/imgo

REDIS_URL=redis://localhost:6379

# Storage driver: local | minio
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads

# MinIO config (required when STORAGE_DRIVER=minio)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=imgo

# Upload limits
MAX_FILE_SIZE_MB=50
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/avif,image/gif,image/svg+xml

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

CORS_ORIGIN=http://localhost:3000

LOG_LEVEL=info

# Required for signed URLs (private images). Generate with: openssl rand -hex 32
SIGNED_URL_SECRET=
